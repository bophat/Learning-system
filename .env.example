# Sao chép file này thành .env.local rồi điền giá trị thật.
# Lấy ở Supabase Dashboard → Project Settings → API.

# Dùng cho web app (được nhúng vào bản build — anon key là khoá công khai, an toàn).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# CHỈ dùng cho script nạp dữ liệu chạy ở máy bạn. Khoá này bỏ qua mọi
# kiểm soát truy cập — không bao giờ đưa lên git hay vào code trình duyệt.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
